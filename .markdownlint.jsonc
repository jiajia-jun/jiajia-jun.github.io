{
  // 关掉 MD025 把 front matter 里的 title 也算成一级标题的行为
  //
  // 一篇文章的标题写在 front matter 的 `title` 里，模板会把它渲染成 <h1>，
  // 但 markdownlint 默认把它也当成文档的一级标题，于是正文里再写一个
  // `# 高精度乘法` 就成了「同一文档里有两个一级标题」，编辑器里报 MD025
  //
  // 把 front_matter_title 置空 = 让它别去 front matter 里找标题，
  // MD025 就只数正文里的 `#`，正文真写了两个一级标题时照样会报，
  // 规则本身并没有被关掉
  "MD025": {
    "front_matter_title": ""
  },

  // 关掉 MD024 跨「章」查重的行为
  //
  // 文章里常在不同小节下复用同一个标题，比如每个算法都有自己的
  // 「核心代码」「例题」「复杂度」，它们各自挂在不同的一级/二级标题下，
  // 互不冲突；markdownlint 默认拿全文比对，于是每复用一次就报一条
  // MD024「Multiple headings with the same content」
  //
  // siblings_only = 只在同一个父标题的兄弟节点之间查重，
  // 相邻两个「核心代码」照样会报，规则本身并没有被关掉
  "MD024": {
    "siblings_only": true
  }
}
